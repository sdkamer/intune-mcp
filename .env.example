# Configuration for intune-mcp. None of these values is a secret.
INTUNE_TENANT_ID=00000000-0000-0000-0000-000000000000
INTUNE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# devices (default), configuration, apps, rbac, enrollment: comma-separated
INTUNE_ENABLED_TOOL_GROUPS=devices
# Opt-in tools that return tenant-wide data ignoring a scoped admin's Intune scope. Default false.
INTUNE_ENABLE_TENANT_INVENTORY=false
# Set to 0 to turn off the once-a-day release check.
INTUNE_UPDATE_CHECK=1
